# Copie para .env (local) e preencha. Na Vercel, cadastre as mesmas variáveis em Settings → Environment Variables.

# Banco Postgres (Neon). A integração Neon da Vercel cria as duas automaticamente.
DATABASE_URL="postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/elgo?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/elgo?sslmode=require"

# Segredo da sessão de login. Gere com: openssl rand -base64 32
AUTH_SECRET=""

# Domínio raiz da plataforma (sem https://). Local: localhost:3000. Produção: ex. elgo.com.br
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"

# Opcional: liga os domínios próprios dos clientes automaticamente na Vercel.
# Token em vercel.com/account/tokens; IDs em Project → Settings → General.
VERCEL_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""
